{
  "manifest_version": 3,
  "name": "Hide Scrollbars",
  "version": "1.0",
  "description": "Example extension: hides the scrollbars on every page.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["hide-scrollbars.css"],
      "js": ["hide-scrollbars.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
